{
    "manifest_version": 3,
    "name": "PageChat AI",
    "version": "1.0.0",
    "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "sidePanel"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "background": {
      "service_worker": "service-worker.js"
    },
    "action": {
      "default_title": "Open PageChat AI"
    },
    "side_panel": {
      "default_path": "index.html"
    }
  }  